{
  "name": "s3-test-server",
  "version": "1.0.0",
  "description": "A modern, lightweight Amazon S3 emulator for local development and testing. Compatible with AWS SDK v2 and v3, Signature V2/V4, path-style and virtual-host-style addressing, streaming (aws-chunked) uploads and flexible checksums.",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "s3-test-server": "bin/s3-test-server.js"
  },
  "files": [
    "lib",
    "bin"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node bin/s3-test-server.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "s3",
    "aws",
    "emulator",
    "mock",
    "test",
    "server",
    "storage"
  ],
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@eslint/js": "^10.0.1",
    "aws-sdk": "^2.1692.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10"
  }
}
